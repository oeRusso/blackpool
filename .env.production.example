# Copy to .env on the server and fill in the blanks. Never commit the real file.
APP_NAME=BlackPool
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://blackpool.example.com
APP_REPOSITORY_URL=https://github.com/your-user/blackpool

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=blackpool
DB_USERNAME=blackpool
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

SESSION_DRIVER=redis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_QUEUE_RETRY_AFTER=3660

# Lesson videos: Nginx streams files authorized by Laravel.
MEDIA_ACCEL_REDIRECT_PREFIX=/protected-media
MEDIA_CHUNK_SIZE=8388608
MEDIA_MAX_UPLOAD_SIZE=2147483648

SECURITY_CSP_ENABLED=true
SECURITY_HSTS=true

# Free SMTP (e.g. Brevo 300/day or Resend 3000/month)
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@blackpool.example.com
MAIL_FROM_NAME="${APP_NAME}"

# Off-site backups on Backblaze B2 (10 GB free)
BACKUP_DISK=backups
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=eu-central-003
BACKUP_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
BACKUP_NOTIFICATION_EMAIL=
BACKUP_INCLUDE_MEDIA=false

PULSE_ENABLED=true

# Public portfolio demo (protected shared accounts + nightly reset)
DEMO_MODE=true
