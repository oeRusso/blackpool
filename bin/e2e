#!/usr/bin/env bash
# Run the Playwright end-to-end suite against a freshly seeded copy of the app.
#   bin/e2e                 # all specs
#   bin/e2e e2e/admin.spec.ts --grep "categories"
set -euo pipefail
cd "$(dirname "$0")/.."

PORT="${E2E_PORT:-8010}"
SERVER="blackpool-e2e-server"
WORKER="blackpool-e2e-worker"
SSR="blackpool-e2e-ssr"
PW_VERSION="$(node -p "require('./node_modules/@playwright/test/package.json').version")"

# E2E_BASE_URL=http://host:port runs the suite against an already running stack
# (e.g. the production compose stack) instead of booting the dev server.
if [ -n "${E2E_BASE_URL:-}" ]; then
  exec docker run --rm --ipc=host --network host -u "$(id -u):$(id -g)" -e HOME=/tmp \
    -e E2E_BASE_URL -e CI="${CI:-}" -v "$PWD":/work -w /work \
    "mcr.microsoft.com/playwright:v${PW_VERSION}-noble" npx playwright test "$@"
fi

cleanup() { docker rm -f "$SERVER" "$WORKER" "$SSR" >/dev/null 2>&1 || true; }
trap cleanup EXIT
cleanup

# Dedicated local environment (gitignored) so the dev database is never touched.
# SSR errors fail loudly instead of silently falling back to client rendering.
bin/make-env .env.e2e APP_ENV=e2e "APP_URL=http://127.0.0.1:${PORT}" \
  DB_DATABASE=/data/e2e.sqlite MEDIA_ROOT=/data/e2e-media MEDIA_CHUNK_SIZE=1048576 \
  MAIL_MAILER=log DEMO_MODE=true INERTIA_SSR_THROW_ON_ERROR=true

# Small sample video used by the upload spec (generated once with ffmpeg).
[ -f e2e/fixtures/sample.mp4 ] || bin/d ffmpeg -hide_banner -loglevel error -f lavfi -i testsrc2=duration=6:size=1280x720:rate=25 \
  -f lavfi -i sine=frequency=440:duration=6 -shortest -c:v libx264 -b:v 3M -c:a aac -y e2e/fixtures/sample.mp4

# Client assets + SSR bundle (bootstrap/ssr).
[ "${E2E_SKIP_BUILD:-0}" = "1" ] || bin/d npm run build >/dev/null

docker run --rm -u "$(id -u):$(id -g)" -e HOME=/tmp -e APP_ENV=e2e \
  -v "$PWD":/app -v blackpool-data:/data -w /app blackpool-dev \
  sh -c 'touch /data/e2e.sqlite && rm -rf /data/e2e-media && php artisan migrate:fresh --seed --force -q && php artisan storage:link -q 2>/dev/null || true'

docker run -d --name "$SERVER" -u "$(id -u):$(id -g)" -e HOME=/tmp -e APP_ENV=e2e \
  -e PHP_CLI_SERVER_WORKERS=4 \
  -v "$PWD":/app -v blackpool-data:/data -w /app --network host blackpool-dev \
  php artisan serve --host=127.0.0.1 --port="$PORT" --no-reload >/dev/null

docker run -d --name "$SSR" -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -v "$PWD":/app -w /app --network host blackpool-dev \
  node bootstrap/ssr/app.js >/dev/null

docker run -d --name "$WORKER" -u "$(id -u):$(id -g)" -e HOME=/tmp -e APP_ENV=e2e \
  -v "$PWD":/app -v blackpool-data:/data -w /app --network host blackpool-dev \
  php artisan queue:work --queue=media,default --tries=2 --timeout=600 >/dev/null

for _ in $(seq 1 60); do
  curl -fs "http://127.0.0.1:${PORT}/up" >/dev/null && curl -fs http://127.0.0.1:13714/health >/dev/null && break
  sleep 0.5
done

docker run --rm --ipc=host --network host -u "$(id -u):$(id -g)" -e HOME=/tmp -e CI="${CI:-}" -e SCREENSHOTS="${SCREENSHOTS:-}" \
  -v "$PWD":/work -w /work "mcr.microsoft.com/playwright:v${PW_VERSION}-noble" \
  npx playwright test "$@"
