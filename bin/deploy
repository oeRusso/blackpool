#!/usr/bin/env bash
# Runs ON THE VPS, by hand, from ~/blackpool: updates to the latest main and
# restarts the stack. Migrations run when the `app` container starts.
# Nothing deploys automatically and no CI service holds an SSH key to the VPS.
set -euo pipefail
cd "$(dirname "$0")/.."

git pull --ff-only origin main

export IMAGE_TAG="$(git rev-parse --short HEAD)"
docker compose up -d --build --remove-orphans --wait

# Make long-running workers pick up the new code.
docker compose exec -T app php artisan queue:restart
docker compose exec -T app php artisan pulse:restart || true

docker image prune -f >/dev/null
echo "Deployed ${IMAGE_TAG}"
